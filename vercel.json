{
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/moments",
      "destination": "/frames/",
      "permanent": true
    },
    {
      "source": "/moments/",
      "destination": "/frames/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg|ico|m4a|mp3|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
